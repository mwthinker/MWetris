{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "http://mwthinker/schemas/tetris-0.1.json",

	"type": "object",
	"properties": {
		"$schema":  { "type": "string" },
		"window": { "$ref": "#/definitions/Window" },
		"inputProfiles": { "$ref": "#/definitions/InputProfiles" },
		"devices": { "$ref": "#/definitions/Devices" },
		"network": { "$ref": "#/definitions/Network" },
		"ai1": { "type": "string", "minLength": 1 },
		"ai2": { "type": "string", "minLength": 1 },
		"ai3": { "type": "string", "minLength": 1 },
		"ai4": { "type": "string", "minLength": 1 },
		"ais": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"name": { "type": "string", "minLength": 1 },
					"valueFunction": { "type": "string", "minLength": 1 }
				},
				"required": ["name", "valueFunction"],
				"additionalProperties": false
			}
		}
	},
	"required": ["window", "network", "inputProfiles", "devices", "ai1", "ai2", "ai3" ,"ai4", "ais"],
	"additionalProperties": false,
	
	"definitions": {
		"BlockType":{
			"type": "string",
			"pattern": "^[IJLSZTO]$"
		},

		"Block": {
			"type": "object",
			"properties": {
				"bottomRow": { "type": "integer" },
				"blockType": { "$ref": "#/definitions/BlockType" },
				"leftColumn": { "type": "integer" },
				"currentRotation": { "type": "integer" }
			},
			"additionalProperties": false
		},

		"Device":  {
			"type": "object",
			"properties": {
				"name": { "type": "string" },
				"ai": { "type": "boolean" }
			},
			"additionalProperties": false
		},

		"Player":  {
			"type": "object",
			"properties": {
				"name": { "type": "string" },
				"lastPosition": { "type": "integer" },
				"nextBlockType": { "$ref": "#/definitions/BlockType" },
				"levelUpCounter": { "type": "integer" },
				"ai": { "type": "boolean" },
				"clearedRows": { "type": "integer" },
				"level": { "type": "integer" },
				"points": { "type": "integer" },
				"currentBlock": { "$ref": "#/definitions/Block" },
				"board": {
					"type": "string",
					"pattern": "^[IJLSZTOEW]*$"
				},
				"device": { "$ref": "#/definitions/Device" }
			},
			"additionalProperties": false
		},

		"Color":{
			"type": "string",
			"description": "Hex color in RGB or RGBA",
			"pattern": "^((#(?:[0-9a-fA-F]{3}){1,2})|(#(?:[0-9a-fA-F]{4}){1,2}))$"
		},

		"Ip":{
			"type": "string",
			"pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}$"
		},
		"Port":{
			"type": "integer",
			"minimum": 1,
			"maximum": 65535
		},

		"Date":{
			"type": "string",
			"pattern": "^20[0-9]{2}\\-[01][0-9]\\-[0-3][0-9]$"
		},

		"Window": {
			"type": "object",
			"properties": {
				"fullscreenOnDoubleClick": { "type": "boolean" },
				"border": { "type": "boolean" },
				"pauseOnLostFocus": { "type": "boolean" },
				"moveWindowByHoldingDownMouse": { "type": "boolean" },
				"vsync": { "type": "boolean" },
				"limitFps": { "type": "boolean" },
				"uiScale": { "type": "number", "minimum": 0.5, "maximum": 2.0 },
				"multiSampleBuffers": { "type": "integer" },
				"multiSampleSamples": { "type": "integer" },
				"rowFadingTime": { "type": "number" },
				"rowMovingTime": { "type": "number" },
				"bar": { "$ref": "#/definitions/Bar" },
				"label": { "$ref": "#/definitions/Label" },
				"checkBox": { "$ref": "#/definitions/CheckBox" },
				"radioButton": { "$ref": "#/definitions/RadioButton" },
				"button": { "$ref": "#/definitions/Button" },
				"comboBox": { "$ref": "#/definitions/ComboBox" },
				"font": { "type": "string", "minLength": 1 },
				"width": { "type": "integer", "minimum": 320, "maximum": 7680 },
				"height": { "type": "integer", "minimum": 320, "maximum": 4320 },
				"positionX": { "type": "integer" },
				"positionY": { "type": "integer" },
				"maximized": { "type": "boolean" },
				"resizeable": { "type": "boolean" },
				"minWidth": { "type": "integer", "minimum": 200, "maximum": 7680 },
				"minHeight": { "type": "integer", "minimum": 200, "maximum": 4320 },
				"icon": { "type": "string", "minLength": 1 },
				"sprites": {
					"type": "object",
					"properties": {
						"background": { "type": "string", "minLength": 1 }
					},
					"required": ["background"],
					"additionalProperties": false
				},
				"tetrisBoard": { "$ref": "#/definitions/TetrisBoard" }
			},
			"required": ["fullscreenOnDoubleClick", "border", "pauseOnLostFocus", "moveWindowByHoldingDownMouse", "vsync", "limitFps", "uiScale", "multiSampleBuffers", "multiSampleSamples", "rowFadingTime", "rowMovingTime", "bar", "label", "checkBox", "radioButton", "button", "comboBox", "font", "width", "height", "positionX", "positionY", "maximized", "resizeable", "minWidth", "minHeight", "icon", "sprites", "tetrisBoard" ],
			"additionalProperties": false
		},
		"Bar": {
			"type": "object",
			"properties": {
				"height": { "type": "number" },
				"color": { "$ref": "#/definitions/Color" }
			},
			"required": ["height", "color"],
			"additionalProperties": false
		},
		"Label": {
			"type": "object",
			"properties": {
				"textColor": { "$ref": "#/definitions/Color" },
				"backgroundColor": { "$ref": "#/definitions/Color" }
			},
			"required": ["textColor", "backgroundColor"],
			"additionalProperties": false
		},
		"CheckBox": {
			"type": "object",
			"properties": {
				"textColor": { "$ref": "#/definitions/Color" },
				"backgroundColor": { "$ref": "#/definitions/Color" },
				"checkColor": { "$ref": "#/definitions/Color" },
				"boxColor": { "$ref": "#/definitions/Color" }
			},
			"required": ["textColor", "backgroundColor", "checkColor", "boxColor"],
			"additionalProperties": false
		},
		"RadioButton": {
			"type": "object",
			"properties": {
				"textColor": { "$ref": "#/definitions/Color" },
				"backgroundColor": { "$ref": "#/definitions/Color" },
				"checkColor": { "$ref": "#/definitions/Color" },
				"boxColor": { "$ref": "#/definitions/Color" }
			},
			"required": ["textColor", "backgroundColor", "checkColor", "boxColor"],
			"additionalProperties": false
		},
		"Button": {
			"type": "object",
			"properties": {
				"focusColor": { "$ref": "#/definitions/Color" },
				"textColor": { "$ref": "#/definitions/Color" },
				"hoverColor": { "$ref": "#/definitions/Color" },
				"pushColor": { "$ref": "#/definitions/Color" },
				"backgroundColor": { "$ref": "#/definitions/Color" },
				"borderColor": { "$ref": "#/definitions/Color" }
			},
			"required": ["focusColor", "textColor", "hoverColor", "pushColor", "backgroundColor", "borderColor"],
			"additionalProperties": false
		},
		"ComboBox": {
			"type": "object",
			"properties": {
				"textColor": { "$ref": "#/definitions/Color" },
				"focusColor": { "$ref": "#/definitions/Color" },
				"backgroundColor": { "$ref": "#/definitions/Color" },
				"selectedTextColor": { "$ref": "#/definitions/Color" },
				"selectedBackgroundColor": { "$ref": "#/definitions/Color" },
				"borderColor": { "$ref": "#/definitions/Color" },
				"showDropDownColor": { "$ref": "#/definitions/Color" }
			},
			"required": ["textColor", "focusColor", "backgroundColor", "selectedTextColor", "selectedBackgroundColor", "borderColor", "showDropDownColor"],
			"additionalProperties": false
		},
		"TetrisBoard": {
			"type": "object",
			"properties": {
				"font": { "type": "string", "minLength": 1 },
				"squareSize": { "type": "number" },
				"borderSize": { "type": "number", "minimum": 0, "maximum": 20 },
				"colorScheme": {
					"type": "string",
					"enum": ["frostedBlue", "classicCrimson", "warmSand", "highContrast", "custom"]
				},
				"sprites": {
					"type": "object",
					"properties": {
						"squareZ": { "type": "string", "minLength": 1 },
						"squareS": { "type": "string", "minLength": 1 },
						"squareJ": { "type": "string", "minLength": 1 },
						"squareI": { "type": "string", "minLength": 1 },
						"squareL": { "type": "string", "minLength": 1 },
						"squareT": { "type": "string", "minLength": 1 },
						"squareO": { "type": "string", "minLength": 1 }
					},
					"required": ["squareZ", "squareS", "squareJ", "squareI", "squareL", "squareT", "squareO"],
					"additionalProperties": false
				},
				"borderColor": { "$ref": "#/definitions/Color" },
				"startAreaColor": { "$ref": "#/definitions/Color" },
				"outerSquareColor": { "$ref": "#/definitions/Color" },
				"innerSquareColor": { "$ref": "#/definitions/Color" },
				"playerCardBackgroundColor": { "$ref": "#/definitions/Color" },
				"playerCardBorderColor": { "$ref": "#/definitions/Color" },
				"sidebarBackgroundColor": { "$ref": "#/definitions/Color" },
				"sidebarBorderColor": { "$ref": "#/definitions/Color" },
				"previewBackgroundColor": { "$ref": "#/definitions/Color" },
				"previewBorderColor": { "$ref": "#/definitions/Color" },
				"playerCardTextColor": { "$ref": "#/definitions/Color" },
				"playerAreaColor": { "$ref": "#/definitions/Color" },
				"middleTextColor": { "$ref": "#/definitions/Color" },
				"middleTextBoxSize": { "type": "integer" },
				"showDownBlock": { "type": "boolean" },
				"downBlockColor": { "$ref": "#/definitions/Color" }
			},
			"required": ["font", "squareSize", "borderSize", "colorScheme", "sprites", "borderColor", "startAreaColor", "outerSquareColor", "innerSquareColor", "playerCardBackgroundColor", "playerCardBorderColor", "sidebarBackgroundColor", "sidebarBorderColor", "previewBackgroundColor", "previewBorderColor", "playerCardTextColor", "playerAreaColor", "middleTextColor", "middleTextBoxSize", "showDownBlock", "downBlockColor"],
			"additionalProperties": false
		},
		"Highscore": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"name": { "string": "string" },
					"date": { "$ref": "#/definitions/Date" },
					"points": { "type": "integer" }
				},
				"required": ["name", "date", "points"],
				"additionalProperties": false
			}
		},
		"Network": {
			"type": "object",
			"properties": {
				"globalServer": {
					"type": "object",
					"properties": {
						"ip": { "$ref": "#/definitions/Ip" },
						"port": { "$ref": "#/definitions/Port" }
					},
					"required": ["ip", "port"],
					"additionalProperties": false
				},
				"server": {
					"type": "object",
					"properties": {
						"ip": { "$ref": "#/definitions/Ip" },
						"port": { "$ref": "#/definitions/Port" }
					},
					"required": ["ip", "port"],
					"additionalProperties": false
				}
			},
			"required": ["globalServer", "server"],
			"additionalProperties": false
		},
		"InputProfiles": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"id": { "type": "string", "minLength": 1 },
					"name": { "type": "string", "minLength": 1, "maxLength": 29 },
					"das": { "type": "integer", "minimum": 1, "maximum": 1000 },
					"arr": { "type": "integer", "minimum": 1, "maximum": 250 }
				},
				"required": ["id", "name", "das", "arr"],
				"additionalProperties": false
			}
		},
		"Devices": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"guid": { "type": "string", "minLength": 1 },
					"inputProfileId": { "type": "string", "minLength": 1 }
				},
				"required": ["guid", "inputProfileId"],
				"additionalProperties": false
			}
		}
	}
}
