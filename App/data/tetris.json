{
	"$schema": "tetris.schema.json",
	"window": {
		"fullscreenOnDoubleClick": false,
		"border": true,
		"pauseOnLostFocus": true,
		"moveWindowByHoldingDownMouse": false,
		"vsync": true,
		"limitFps": false,
		"uiScale": 1.0,
		"multiSampleBuffers": 0,
		"multiSampleSamples": 0,
		"rowFadingTime": 0.25,
		"rowMovingTime": 0.05,
		"bar": {
			"height": 35,
			"color": "#8000004d"
		},
		"label": {
			"textColor": "#ffffff",
			"backgroundColor": "#ffffff00"
		},
		"checkBox": {
			"textColor": "#ffffff",
			"backgroundColor": "#ffffff00",
			"checkColor": "#00ff00ff",
			"boxColor": "#ffffff"
		},
		"radioButton": {
			"textColor": "#ffffff",
			"backgroundColor": "#ffffff00",
			"checkColor": "#00ff00ff",
			"boxColor": "#ffffff"
		},
		"button": {
			"focusColor": "#cc1a004d",
			"textColor": "#ffffffff",
			"hoverColor": "#991a1a",
			"pushColor": "#cc0000b3",
			"backgroundColor": "#ffffff00",
			"borderColor": "#8a8f98cc"
		},
		"comboBox": {
			"textColor": "#ffffff",
			"focusColor": "#3b4048ff",
			"backgroundColor": "#292d33ff",
			"selectedTextColor": "#ffffff",
			"selectedBackgroundColor": "#991a1a",
			"borderColor": "#8a8f98cc",
			"showDropDownColor": "#ffffff"
		},
		"font": "fonts/inter/Inter_18pt-Regular.ttf",
		"width": 860,
		"height": 1120,
		"positionX": 1496,
		"positionY": 224,
		"maximized": false,
		"resizeable": true,
		"minWidth": 480,
		"minHeight": 480,
		"icon": "images/icon.png",
		"sprites": {
			"background": "images/background.png"
		},
		"tetrisBoard": {
			"font": "fonts/inter/Inter_18pt-Regular.ttf",
			"squareSize": 10,
			"borderSize": 3,
			"colorScheme": "frostedBlue",
			"sprites": {
				"squareZ": "images/Z.png",
				"squareS": "images/S.png",
				"squareJ": "images/J.png",
				"squareI": "images/I.png",
				"squareL": "images/L.png",
				"squareT": "images/T.png",
				"squareO": "images/O.png"
			},
			"borderColor": "#D0E8F2",
			"startAreaColor": "#7199B580",
			"outerSquareColor": "#40566BB3",
			"innerSquareColor": "#71889F66",
			"playerCardBackgroundColor": "#536A80B3",
			"playerCardBorderColor": "#B8D8E8CC",
			"sidebarBackgroundColor": "#607A92CC",
			"sidebarBorderColor": "#B8D8E866",
			"previewBackgroundColor": "#40566BB3",
			"previewBorderColor": "#B8D8E866",
			"playerCardTextColor": "#F5F8FA",
			"playerAreaColor": "#661a2680",
			"middleTextColor": "#33333380",
			"middleTextBoxSize": 7,
			"showDownBlock": true,
			"downBlockColor": "#ffffff26"
		}
	},
	"network": {
		"globalServer": {
			"ip": "127.0.0.1",
			"port": 11155
		},
		"server": {
			"ip": "127.0.0.1",
			"port": 11175
		}
	},
	"inputProfiles": [],
	"devices": [
		{
			"guid": "Keyboard 1",
			"inputProfileId": "balanced",
			"bindings": {
				"type": "keyboard",
				"left": "Left",
				"right": "Right",
				"softDrop": "Down",
				"rotate": "Up",
				"hardDrop": "Right Ctrl"
			}
		},
		{
			"guid": "Keyboard 2",
			"inputProfileId": "balanced",
			"bindings": {
				"type": "keyboard",
				"left": "A",
				"right": "D",
				"softDrop": "S",
				"rotate": "W",
				"hardDrop": "Left Ctrl"
			}
		}
	],
	"ai1": "Default",
	"ai2": "Default",
	"ai3": "Default",
	"ai4": "Default",

	"ais": [
		{
			"name": "Default2",
			"valueFunction": "-0.2*cumulativeWells - 1*holeDepth - 1*holes - 1*landingHeight"
		},
		{
			"name": "Defensive",
			"valueFunction": "-0.2*cumulativeWells - 0.8*holeDepth - 1.1*holes - 0.4*landingHeight"
		}
	]
}
